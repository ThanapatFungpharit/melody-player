<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+'s copy of backup_rules.xml, which explains each exclusion.
     Device-to-device transfer has no size quota, but it would still carry
     the signed-in cookie file and this device's runtime and staging. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="flet/" />
        <exclude domain="file" path="data/cookies.txt" />
        <exclude domain="file" path="data/runtime/" />
        <exclude domain="file" path="data/cache/" />
        <exclude domain="file" path="data/downloads/" />
        <exclude domain="file" path="data/music-move.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="flet/" />
        <exclude domain="file" path="data/cookies.txt" />
        <exclude domain="file" path="data/runtime/" />
        <exclude domain="file" path="data/cache/" />
        <exclude domain="file" path="data/downloads/" />
        <exclude domain="file" path="data/music-move.json" />
    </device-transfer>
</data-extraction-rules>
