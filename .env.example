# Local settings for Melody's tools. Copy to .env and uncomment what you need;
# variables already exported in your shell take precedence. Android signing
# secrets belong in .signing (see `uv run melody-android-key`), not here.

# Flutter SDK, when `flutter` is not on PATH
# FLUTTER_ROOT=C:\path\to\flutter

# JDK for keytool (melody-android-key), when `keytool` is not on PATH
# JAVA_HOME=C:\path\to\jdk
