# Python bytecode, packaging output, and tool caches
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
build/
# ...but tools/build is source
!/tools/build/
/artifacts/
dist/
wheels/
*.egg-info/

# uv virtual environment
.venv/

# Flutter/Dart generated state
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
# Gradle caches, such as the one Android Studio leaves in a plugin's android/
.gradle/

# Local environment and credentials (keep shareable templates)
.env
.env.*
!.env.example
!.env.template
cookies.txt
*.jks
*.keystore

# Local diagnostics and temporary files
*.log
*.tmp

# Local editor and operating-system state
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local Android signing material
.signing
signing/

# Screen-test review output (MELODY_SCREENSHOTS=1)
/app/test/ui/screenshots/

# FFmpeg staged for native builds by tools/build/media.py (melody-fetch-media)
/app/media/
/app/android/app/src/main/jniLibs/
